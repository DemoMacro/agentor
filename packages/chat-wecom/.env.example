# 群机器人 Webhook Key
# https://developer.work.weixin.qq.com/document/path/91770
WECOM_WEBHOOK_KEY=

# 智能机器人 (通过 WECOM_BOT_MODE 或 config.mode 切换模式，默认 WebSocket)
# https://developer.work.weixin.qq.com/document/path/101039

# 模式选择: websocket (默认) | callback
# WECOM_BOT_MODE=callback

# WebSocket 长连接模式 (默认)
WECOM_BOT_WS_BOT_ID=
WECOM_BOT_WS_SECRET=

# 回调 URL 模式
WECOM_BOT_TOKEN=
WECOM_BOT_ENCODING_AES_KEY=

# 企业微信应用配置
# https://developer.work.weixin.qq.com/document/path/90236
WECOM_APP_CORP_ID=
WECOM_APP_CORP_SECRET=
WECOM_APP_AGENT_ID=
WECOM_APP_TOKEN=
WECOM_APP_ENCODING_AES_KEY=
WECOM_APP_USER_ID=
